# Backend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Express server port
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/schoolerp
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/schoolerp
MONGODB_URI=

# JWT secret key (minimum 32 characters in production)
JWT_SECRET=

# JWT token expiry duration (e.g. 7d, 24h)
JWT_EXPIRES=7d

# bcrypt rounds (12 recommended for production)
BCRYPT_ROUNDS=12

# URL of the frontend (used by CORS)
CLIENT_URL=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development
